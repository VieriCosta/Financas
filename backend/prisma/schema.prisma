generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BillStatus {
  PENDING
  PAID
}

enum InvestmentType {
  STOCK
  CRYPTO
  FIXED_INCOME
  EMERGENCY_RESERVE
  OTHER
}

enum RecurringResourceType {
  TRANSACTION
  BILL
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum AiHistoryKind {
  ADVICE
  COMMAND
  REPORT
}

enum AiHistoryStatus {
  ANSWERED
  PENDING
  CONFIRMED
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  tokenVersion Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categories   Category[]
  transactions Transaction[]
  bills        Bill[]
  investments  Investment[]
  goals        Goal[]
  budgets      Budget[]
  recurringRules RecurringRule[]
  aiHistory    AiHistory[]
  dashboardPreference DashboardPreference?
  tags         Tag[]
  attachments  Attachment[]
  monthlyClosings MonthlyClosing[]
  sessions     AuthSession[]
  auditLogs    AuditLog[]
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id           String            @id @default(uuid())
  name         String
  color        String            @default("#2563eb")
  icon         String            @default("Wallet")
  type         TransactionType?
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  recurringRules RecurringRule[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([userId, name])
}

model Transaction {
  id          String          @id @default(uuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  date        DateTime
  notes       String?
  installmentGroupId String?
  installmentNumber  Int?
  installmentTotal   Int?
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tags        TransactionTag[]
  attachments Attachment[]

  @@index([installmentGroupId])
}

model Bill {
  id          String     @id @default(uuid())
  title       String
  amount      Decimal    @db.Decimal(12, 2)
  dueDate     DateTime
  status      BillStatus @default(PENDING)
  isRecurring Boolean    @default(false)
  recurrenceDay Int?
  reminderAt  DateTime?
  notifiedAt  DateTime?
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model DashboardPreference {
  id            String   @id @default(uuid())
  hiddenWidgets String[] @default([])
  widgetOrder   String[] @default([])
  chartMonths   Int      @default(6)
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt     DateTime @updatedAt
}

model Tag {
  id           String           @id @default(uuid())
  name         String
  color        String           @default("#2563eb")
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
  createdAt    DateTime         @default(now())

  @@unique([userId, name])
}

model TransactionTag {
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tagId         String
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
}

model Attachment {
  id            String      @id @default(uuid())
  filename      String
  mimeType      String
  size          Int
  content       Bytes
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

model MonthlyClosing {
  id          String   @id @default(uuid())
  month       Int
  year        Int
  income      Decimal  @db.Decimal(12, 2)
  expense     Decimal  @db.Decimal(12, 2)
  budgetTotal Decimal  @db.Decimal(12, 2)
  snapshot    Json
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([userId, year, month])
}

model AuthSession {
  id         String    @id @default(uuid())
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())

  @@index([userId, revokedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  action     String
  resource   String
  resourceId String?
  details    Json?
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Budget {
  id          String   @id @default(uuid())
  limitAmount Decimal  @db.Decimal(12, 2)
  month       Int
  year        Int
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@index([userId, year, month])
}

model RecurringRule {
  id              String                @id @default(uuid())
  resource        RecurringResourceType
  title           String
  amount          Decimal               @db.Decimal(12, 2)
  transactionType TransactionType?
  frequency       RecurrenceFrequency
  interval        Int                   @default(1)
  dayOfMonth      Int?
  dayOfWeek       Int?
  nextRunAt       DateTime
  active          Boolean               @default(true)
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId      String?
  category        Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([userId, active, nextRunAt])
}

model AiHistory {
  id         String          @id @default(uuid())
  kind       AiHistoryKind
  status     AiHistoryStatus
  request    String
  response   String
  actionJson Json?
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@index([userId, createdAt])
}

model Investment {
  id              String         @id @default(uuid())
  name            String
  type            InvestmentType
  currentValue    Decimal        @db.Decimal(12, 2)
  investedAmount  Decimal        @db.Decimal(12, 2)
  contribution    Decimal        @db.Decimal(12, 2)
  profitability   Decimal        @db.Decimal(8, 2)
  monthlyYieldRate Decimal       @default(0) @db.Decimal(8, 2)
  cdiMonthlyRate   Decimal       @default(0) @db.Decimal(8, 2)
  cdiPercent       Decimal       @default(100) @db.Decimal(8, 2)
  ticker          String?
  quantity        Decimal?       @db.Decimal(18, 8)
  averagePrice    Decimal?       @db.Decimal(18, 8)
  broker          String?
  institution     String?
  indexer         String?
  annualRate      Decimal?       @db.Decimal(8, 2)
  maturityDate    DateTime?
  liquidity       String?
  custodyLocation String?
  walletAddress   String?
  notes           String?
  referenceDate   DateTime       @default(now())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Goal {
  id            String   @id @default(uuid())
  title         String
  targetAmount  Decimal  @db.Decimal(12, 2)
  currentAmount Decimal  @db.Decimal(12, 2)
  deadline      DateTime?
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
